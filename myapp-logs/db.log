        gmd.uom_id,
        'receivedQuantity',
        gmd.received_quantity,
        'unitPrice',
        gmd.unit_price,
        'makeNo',
        gmd.make_no,
        'serialNo',
        gmd.serial_no,
        'modelNo',
        gmd.model_no,
        'warrantyTerms',
        gmd.warranty_terms,
        'note',
        gmd.note,
        'photoPath',
        gmd.photo_path         )     ) as material_details,
        gm.status 
    FROM
        gprn_master gm 
    LEFT JOIN
        goods_inspection_master gim 
            ON gm.sub_process_id = gim.gprn_sub_process_id 
    JOIN
        gprn_material_detail gmd 
            ON gm.sub_process_id = gmd.sub_process_id 
    WHERE
        gim.inspection_sub_process_id IS NULL 
        AND     gm.status = ? 
        AND     gm.created_by = ? 
    GROUP BY
        gm.sub_process_id 
    ORDER BY
        gm.date DESC 
